# App under test
BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080/api/v1

# Browser
BROWSER=chrome
HEADLESS=true

# Test user (must already exist and be verified in the backend's MongoDB)
TEST_USER_EMAIL=narayanaswamy@getrecord.in
TEST_USER_PASSWORD=Swamy@12

# Timeouts (ms)
DEFAULT_TIMEOUT=10000

# Must point at the SAME MongoDB the backend under test is using (its MONGO_TEST_URI/MONGO_URI),
# so tests can read the OTP that the backend just wrote instead of reading real email/SMS.
# Never point this at a production database.
MONGO_URI=mongodb://127.0.0.1:27017/record-studio-test
